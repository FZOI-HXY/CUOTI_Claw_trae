# ======================================================
# DocFlow — AI智能文档识别与管理系统 - .gitignore
# ======================================================

# ── Python ──
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
*.egg
dist/
build/
*.spec
eggs/
.eggs/
*.manifest

# ── Virtual Environment ──
venv/
.venv
env/
ENV/

# ── 环境配置（含密钥）──
.env
*.env.local
*.env.production
apps/web/api/.env
apps/desktop/nas_config.json

# ── Cloudflare Tunnel 凭证（敏感文件，切勿提交）──
deploy/cloudflared/cert.pem
deploy/cloudflared/*.json
C:\Users\IDC\.cloudflared/

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── PyInstaller 构建产物 ──
apps/desktop/dist/
apps/desktop/build/
apps/desktop/*.spec
apps/desktop/app_icon.ico
apps/desktop/local_cache/

# ── 测试 ──
.pytest_cache/
htmlcov/
.coverage
.coverage.*
*.cover
reports/
*_result.txt
*_result2.txt
test_output.txt
markdown_test_result.txt

# ── 运行时数据目录（统一在 data/ 下）──
data/uploads/*
data/output/*
data/logs/*
!data/uploads/.gitkeep
!data/output/.gitkeep
!data/logs/.gitkeep
# 兼容历史路径（防止重新生成）
uploads/*
output/*
logs/*
!uploads/.gitkeep
!output/.gitkeep
!logs/.gitkeep
apps/web/api/uploads/*
apps/web/api/output/*
apps/web/api/logs/*
apps/desktop/output/*
apps/desktop/logs/*

# ── 日志文件 ──
*.log

# ── 临时文件 ──
*.tmp
*.temp
*.bak
*.cache
tmp/
temp/
~$*
# 临时 diff/快照文件
tmp_*.txt
old_*.py
*_diff.txt
commit_diff.txt

# ── TRAE 临时目录 ──
.trae-html-share-packages/

# ── 操作系统 ──
Desktop.ini
$RECYCLE.BIN/

# ── 其他 ──
*.wpr
*.wpu
