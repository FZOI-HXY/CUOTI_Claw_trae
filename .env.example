# ======================================================
# Claw 错题管理系统 - 生产环境配置模板
# ======================================================
#
# 使用方法：
#   1. 复制本文件为 .env
#   2. 填写下方各项配置
#   3. docker compose up -d
#
#   cp .env.example .env
#   nano .env
# ======================================================

# ---------- PaddleOCR API 配置 ----------
# 官方文档: https://ai.baidu.com/ai-doc/AISTUDIO/fml7mozw5
# Token 获取: https://aistudio.baidu.com/paddleocr/task
# 认证方式: Authorization: bearer {TOKEN}

# PaddleOCR API 地址（默认官方地址，如使用代理/中转可修改）
PADDLEOCR_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs

# PaddleOCR API Token（必填，从百度AI Studio获取）
PADDLEOCR_API_KEY=your_token_here

# OCR 模型版本（可选）:
#   PaddleOCR-VL-1.6  - 多模态文档结构化分析（推荐，最新版）
#   PaddleOCR-VL-1.5  - 多模态文档结构化分析
#   PaddleOCR-VL      - 多模态文档结构化分析
#   PP-StructureV3    - 文档结构化分析（版面+OCR+表格+公式）
#   PP-OCRv6          - 文字识别（最新版）
#   PP-OCRv5          - 文字识别
PADDLEOCR_MODEL=PaddleOCR-VL-1.6

# ---------- 服务器配置 ----------
# 监听地址（容器内必须为 0.0.0.0）
HOST=0.0.0.0

# 监听端口
PORT=8500

# 调试模式（生产环境必须为 false，关闭 /docs 接口）
DEBUG=false

# ---------- 文件存储配置 ----------
# 以下目录基于 CLAW_DATA_DIR（docker-compose 中已设为 /app/data）
UPLOAD_DIR=./uploads
OUTPUT_DIR=./output
LOG_DIR=./logs

# 最大上传文件大小（MB）
MAX_UPLOAD_SIZE_MB=50

# ---------- 轮询配置（PaddleOCR 异步任务） ----------
# 轮询间隔（秒）
POLL_INTERVAL=5

# 最大轮询次数（超过则判定为超时）
POLL_MAX_RETRIES=120

# ---------- 速率限制 ----------
# 每窗口最大请求数
RATE_LIMIT_REQUESTS=60

# 窗口大小（秒）
RATE_LIMIT_WINDOW=60

# ---------- 日志配置 ----------
LOG_LEVEL=INFO

# ---------- 可选：本地认证 Token ----------
# 为空表示不启用认证（开发/测试模式）
# 生产环境建议设置随机字符串
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
CLAW_AUTH_TOKEN=
